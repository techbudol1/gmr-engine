APP_ENV=development
GMR_ENGINE_ADDR=:8090
GMR_ENGINE_ADMIN_API_KEY=replace-with-strong-gmr-engine-admin-key
GMR_ENGINE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,https://budolph.xyz,https://*.budolph.xyz,https://*.workers.dev
GMR_ENGINE_RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
# Additional EVM RPCs keyed by chain ID. Add any Alchemy-supported chain here.
GMR_ENGINE_CHAIN_RPC_URLS={"421614":"https://arb-sepolia.g.alchemy.com/v2/your-alchemy-api-key"}
# Solana Alchemy RPCs keyed by cluster. Configure only networks this engine should expose.
GMR_ENGINE_SOLANA_RPC_URLS={"devnet":"https://solana-devnet.g.alchemy.com/v2/your-alchemy-api-key","mainnet":"https://solana-mainnet.g.alchemy.com/v2/your-alchemy-api-key"}
# Optional shared key. If omitted, Engine derives it from an Alchemy URL above.
GMR_ENGINE_ALCHEMY_API_KEY=
GMR_ENGINE_MEMGRAPH_URI=bolt://localhost:7689
GMR_ENGINE_MEMGRAPH_USER=
GMR_ENGINE_MEMGRAPH_PASSWORD=

GMR_ENGINE_OWNER_USERNAME=destrega
GMR_ENGINE_OWNER_EMAIL=
GMR_ENGINE_OWNER_NAME=destrega
GMR_ENGINE_OWNER_PASSWORD=replace-with-strong-owner-password
GMR_ENGINE_SESSION_TTL_HOURS=24

GMR_ENGINE_DEPLOYER_ENABLED=true
GMR_ENGINE_DEPLOYER_INTERVAL_SECONDS=8
GMR_ENGINE_VAULT_ENABLED=true
GMR_ENGINE_VAULT_URL=http://localhost:8091
GMR_ENGINE_VAULT_INTERNAL_API_KEY=replace-with-same-value-as-gmr-vault-internal-api-key

GMR_ENGINE_ZKVERIFY_NETWORK=Volta
GMR_ENGINE_ZKVERIFY_RPC_URL=https://testnet-rpc.zkverify.io
GMR_ENGINE_ZKVERIFY_WS_URL=wss://testnet-rpc.zkverify.io
GMR_ENGINE_ZKVERIFY_SEED_PHRASE=
